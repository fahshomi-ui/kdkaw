# انسخ إلى .env للتشغيل خارج Manus. لا تضع .env في Git.
PORT=3000
# قاعدة بيانات MySQL دائمة. Manus يحقن هذا المتغير تلقائيًا.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# استضافة تتطلب TLS: أضف ?ssl=true إلى نهاية الرابط إن لم يتضمن إعداد SSL.
# الواجهة وخادم Socket.IO يعملان من العنوان والمنفذ نفسيهما.
# لا توجد لوحة تحكم أو بيانات دخول مطلوبة.
